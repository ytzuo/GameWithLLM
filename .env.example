# Agent Service
AGENT_SERVICE_ADDR=:8080
AGENT_SERVICE_BASE_URL=http://127.0.0.1:8080
A2A_AGENT_URL=http://127.0.0.1:8080/a2a
A2A_BEARER_TOKEN=replace-with-a-short-lived-session-token

# Unified Unity Runtime transport (loopback locally, wss:// in production)
UNITY_INSTANCE_ID=local-game-1
PLAYER_ID=local-player-1
UNITY_SCENE_ID=warehouse-demo
RUNTIME_GATEWAY_WS_URL=ws://127.0.0.1:8080/runtime/ws
RUNTIME_GATEWAY_TOKEN=replace-with-a-short-lived-device-token

# Service identity for optional virtual MCP clients
MCP_GATEWAY_SERVICE_TOKEN=replace-with-a-service-identity-token

# LLM and Agent-owned snapshots
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ROUNDS=4
LLM_MAX_CONTEXT_CHARS=32000
CONVERSATION_SAVE_DIR=GameMCPServer/data/conversations
NPC_PROFILE_PATH=GameMCPServer/config/npc_profiles.json
