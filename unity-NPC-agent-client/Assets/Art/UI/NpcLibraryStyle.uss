.npc-library-root {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    padding: 28px 34px; align-items: center; justify-content: center;
    background-color: rgba(3, 6, 12, 0.88);
}
.npc-library-panel {
    width: 1180px; height: 664px; max-width: 100%; max-height: 100%;
    background-color: rgba(7, 10, 18, 0.97); border-width: 1px;
    border-color: rgba(130, 160, 205, 0.52); border-radius: 14px; overflow: hidden;
}
.npc-library-header { height: 68px; flex-shrink: 0; flex-direction: row; align-items: center;
    padding-left: 22px; padding-right: 14px; background-color: #111A2A;
    border-bottom-width: 1px; border-bottom-color: rgba(130, 160, 205, 0.22); }
.npc-library-title-block { flex-grow: 1; }
.npc-library-title { color: #F7FAFF; font-size: 19px; -unity-font-style: bold; }
.npc-library-kicker { color: #72839D; font-size: 11px; margin-top: 2px; }
.npc-library-close { width: 38px; height: 38px; padding: 0; color: #B9C7DC; font-size: 25px;
    background-color: transparent; border-width: 1px; border-color: transparent; border-radius: 8px; }
.npc-library-close:hover { color: #FFFFFF; background-color: rgba(255,255,255,0.07); border-color: rgba(130,160,205,0.32); }
.npc-library-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.npc-library-main { flex-grow: 1; min-width: 0; padding: 18px 18px 14px 20px; }
.npc-library-toolbar { height: 42px; flex-shrink: 0; flex-direction: row; align-items: center; margin-bottom: 14px; }
.npc-library-tabs { flex-direction: row; margin-right: 14px; }
.npc-library-tab { height: 38px; min-width: 92px; margin-right: 6px; color: #94A7C4; font-size: 14px;
    background-color: #141F31; border-width: 1px; border-color: rgba(130,160,205,0.24); border-radius: 8px; }
.npc-library-tab:hover { color: #F7FAFF; border-color: rgba(130,160,205,0.55); }
.npc-library-tab--active { color: #FFFFFF; background-color: rgba(47,117,232,0.24); border-color: #2F75E8; -unity-font-style: bold; }
.npc-library-search-wrap { flex-grow: 1; height: 38px; }
.npc-library-search { position: absolute; top: 0; left: 0; right: 0; bottom: 0; color: #D2DDF0; }
.npc-library-search-placeholder { position: absolute; left: 14px; top: 9px; color: #72839D; font-size: 13px; }
.npc-library-search-placeholder--hidden { display: none; }
.npc-library-search .unity-base-text-field__input { padding-left: 13px; color: #F7FAFF; background-color: #0E1522;
    border-width: 1px; border-color: rgba(130,160,205,0.36); border-radius: 8px; }
.npc-library-search .unity-base-text-field__input:focus { border-color: #2F75E8; }
.npc-library-scroll { flex-grow: 1; min-height: 0; }
.npc-library-scroll .unity-scroll-view__content-container { padding: 2px; }
.npc-library-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.npc-library-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.npc-library-card { width: 168px; height: 208px; flex-shrink: 0; margin-right: 12px; margin-bottom: 12px;
    background-color: #1A2338; border-width: 1px; border-color: rgba(130,160,205,0.28); border-radius: 11px;
    overflow: hidden; -unity-background-scale-mode: scale-and-crop; }
.npc-library-card:hover { border-color: rgba(130,178,255,0.8); }
.npc-library-card:focus { border-width: 2px; border-color: #82B2FF; }
.npc-library-card--selected { border-width: 2px; border-color: #2F75E8; }
.npc-library-card-placeholder { position: absolute; top: 0; left: 0; right: 0; bottom: 42px;
    align-items: center; justify-content: center; background-color: #18243A; }
.npc-library-card-name-strip { position: absolute; left: 0; right: 0; bottom: 0; height: 42px;
    padding-left: 12px; padding-right: 10px; justify-content: center; background-color: rgba(2,5,10,0.78); }
.npc-library-card-name { color: #FFFFFF; font-size: 14px; -unity-font-style: bold;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-overflow-position: end; }
.npc-library-installed-badge { position: absolute; top: 9px; left: 9px; height: 25px; padding-left: 8px; padding-right: 8px;
    color: #FFFFFF; background-color: rgba(29,104,82,0.94); border-width: 1px; border-color: #55C7A5;
    border-radius: 6px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; }
.npc-library-placeholder { width: 76px; height: 76px; align-items: center; justify-content: flex-end; }
.npc-library-placeholder-head { position: absolute; top: 5px; width: 30px; height: 30px; border-radius: 15px;
    background-color: rgba(148,167,196,0.52); }
.npc-library-placeholder-body { width: 66px; height: 38px; border-radius: 24px 24px 8px 8px;
    background-color: rgba(148,167,196,0.34); }
.npc-library-state { position: absolute; top: 70px; left: 20px; right: 18px; bottom: 14px;
    align-items: center; justify-content: center; background-color: #0E1522; border-radius: 10px; }
.npc-library-state--hidden { display: none; }
.npc-library-state-icon { width: 38px; height: 38px; margin-bottom: 13px; border-width: 2px;
    border-radius: 19px; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; }
.npc-library-state-icon--loading { color: #82B2FF; border-color: rgba(47,117,232,0.55); }
.npc-library-state-icon--empty { color: #94A7C4; border-color: rgba(130,160,205,0.28); }
.npc-library-state-icon--error { color: #F19595; border-color: rgba(241,149,149,0.55); }
.npc-library-state-title { color: #D2DDF0; font-size: 15px; -unity-font-style: bold; }
.npc-library-state-detail { color: #72839D; font-size: 12px; margin-top: 5px; margin-bottom: 14px; }
.npc-library-secondary-button { min-width: 96px; height: 34px; color: #D2DDF0; background-color: #1A263B;
    border-width: 1px; border-color: rgba(130,160,205,0.42); border-radius: 8px; }
.npc-library-secondary-button:focus, .npc-library-tab:focus, .npc-library-close:focus,
.npc-library-action:focus { border-width: 2px; border-color: #82B2FF; }
.npc-library-detail { width: 312px; flex-shrink: 0; padding: 18px 20px 20px 20px; background-color: #0C1320;
    border-left-width: 1px; border-left-color: rgba(130,160,205,0.22); }
.npc-library-detail-avatar { height: 264px; flex-shrink: 0; align-items: center; justify-content: center;
    background-color: #18243A; border-width: 1px; border-color: rgba(130,160,205,0.28); border-radius: 11px;
    overflow: hidden; -unity-background-scale-mode: scale-and-crop; }
.npc-library-detail-copy-scroll { flex-grow: 1; flex-shrink: 1; min-height: 92px; margin-top: 12px; margin-bottom: 8px; }
.npc-library-detail-copy-scroll .unity-scroll-view__content-container { padding-right: 5px; }
.npc-library-detail-copy-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.npc-library-detail-copy-scroll .unity-scroll-view__vertical-scroller { width: 6px; min-width: 6px; }
.npc-library-detail-name { color: #F7FAFF; font-size: 21px; -unity-font-style: bold; white-space: normal; }
.npc-library-detail-version { margin-top: 3px; color: #5E98F3; font-size: 11px; }
.npc-library-detail-description { margin-top: 12px; color: #B9C7DC; font-size: 13px; white-space: normal; }
.npc-library-detail-footer { flex-shrink: 0; }
.npc-library-status { min-height: 30px; margin-bottom: 7px; color: #94A7C4; font-size: 12px; white-space: normal; }
.npc-library-status--error { color: #F19595; }
.npc-library-progress { height: 7px; margin-bottom: 12px; }
.npc-library-progress .unity-progress-bar__background { background-color: #263247; border-width: 0; border-radius: 4px; }
.npc-library-progress .unity-progress-bar__progress { background-color: #2F75E8; border-radius: 4px; }
.npc-library-progress .unity-progress-bar__title { display: none; }
.npc-library-progress--hidden { display: none; }
.npc-library-action { height: 42px; color: #FFFFFF; background-color: #2F75E8; border-width: 1px;
    border-color: #5E98F3; border-radius: 9px; font-size: 14px; -unity-font-style: bold; }
.npc-library-action:hover { background-color: #3D82F0; }
.npc-library-action:active { background-color: #205FC8; }
.npc-library-action:disabled { color: #72839D; background-color: #2A3550; border-color: rgba(130,160,205,0.2); }
