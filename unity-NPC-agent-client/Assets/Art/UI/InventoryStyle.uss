.inv-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 10, 18, 0.82);
}

.inv-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* ── Panel ──────────────────────────────────────────────── */

.inv-panel {
    flex-direction: column;
    background-color: #111723;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 14px;
    padding: 20px;
    width: 600px;
    min-height: 520px;
    max-height: 720px;
    overflow: hidden;
}

.inv-panel-header {
    flex-direction: row;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 160, 205, 0.20);
}

.inv-panel-title {
    font-size: 16px;
    color: #F7FAFF;
    -unity-font-style: bold;
}

/* ── Section Label ──────────────────────────────────────── */

.inv-section-label {
    font-size: 13px;
    color: #94A7C4;
    margin-top: 12px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

/* ── Divider ────────────────────────────────────────────── */

.inv-divider {
    height: 2px;
    background-color: rgba(130, 160, 205, 0.15);
    margin-top: 12px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

/* ── Holder ScrollView ──────────────────────────────────── */

.inv-holder-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
    max-height: 260px;
}

.inv-holder-scroll .unity-scroll-view__content-container {
    padding: 4px;
}

.inv-holder-scroll .unity-scroll-view__vertical-scroller {
    width: 7px;
    background-color: transparent;
}

.inv-holder-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(130, 160, 205, 0.3);
    border-radius: 4px;
}

.inv-holder-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(130, 160, 205, 0.5);
}

.inv-holder-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.inv-holder-scroll .unity-base-slider--horizontal,
.inv-holder-scroll .unity-base-slider__low-button,
.inv-holder-scroll .unity-base-slider__high-button {
    display: none;
}

/* ── Grid ───────────────────────────────────────────────── */

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ── Slot ───────────────────────────────────────────────── */

.inv-slot {
    width: 64px;
    height: 64px;
    background-color: #1A2338;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.25);
    border-radius: 8px;
    margin: 4px;
    overflow: hidden;
}

.inv-slot:hover {
    border-color: rgba(130, 160, 205, 0.55);
}

.inv-slot--empty {
    border-color: rgba(130, 160, 205, 0.12);
    background-color: rgba(26, 35, 56, 0.4);
}

/* ── Slot Icon ──────────────────────────────────────────── */

.inv-slot-icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ── Slot Quantity ──────────────────────────────────────── */

.inv-slot-quantity {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 13px;
    color: #F7FAFF;
    -unity-font-style: bold;
    background-color: rgba(7, 10, 18, 0.7);
    padding: 0 4px;
    border-radius: 4px;
}

.inv-slot-quantity--hidden {
    opacity: 0;
}

/* ── Slot Highlight ─────────────────────────────────────── */

.inv-slot-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-color: #2F75E8;
    border-radius: 8px;
    opacity: 0;
}

/* ============================================ */
/* Inventory List View                          */
/* ============================================ */

.inv-list-root {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(7, 10, 18, 0.82);
}

.inv-list-panel {
    flex-direction: column;
    width: 400px;
    max-height: 560px;
    background-color: #111723;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 14px;
    padding: 20px;
    overflow: hidden;
}

.inv-list-header {
    flex-direction: column;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 160, 205, 0.20);
    margin-bottom: 8px;
}

.inv-list-title {
    font-size: 18px;
    color: #F7FAFF;
    -unity-font-style: bold;
}

.inv-list-subtitle {
    font-size: 12px;
    color: #94A7C4;
    margin-top: 4px;
}

.inv-list-scroll {
    flex-grow: 1;
}

.inv-list-scroll .unity-scroll-view__content-container {
    padding: 4px;
}

.inv-list-scroll .unity-scroll-view__vertical-scroller {
    width: 7px;
    background-color: transparent;
}

.inv-list-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(130, 160, 205, 0.3);
    border-radius: 4px;
}

.inv-list-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.inv-list-scroll .unity-base-slider--horizontal,
.inv-list-scroll .unity-base-slider__low-button,
.inv-list-scroll .unity-base-slider__high-button {
    display: none;
}

.inv-list-container {
    flex-direction: column;
}

.inv-list-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 4px;
    background-color: #1A2338;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.20);
    border-radius: 8px;
}

.inv-list-item:hover {
    background-color: #222D44;
    border-color: rgba(130, 160, 205, 0.40);
}

.inv-list-item:active {
    background-color: #1A2D4A;
    border-color: #2F75E8;
}

.inv-list-item-icon {
    width: 32px;
    height: 32px;
    background-color: #2F75E8;
    border-radius: 6px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
}

.inv-list-item-name {
    font-size: 14px;
    color: #D2DDF0;
    flex-grow: 1;
}

.inv-list-item-arrow {
    font-size: 18px;
    color: #94A7C4;
    margin-left: 8px;
}

.inv-list-empty {
    font-size: 14px;
    color: #72839D;
    padding: 24px;
    align-items: center;
    justify-content: center;
}

/* ============================================ */
/* Item Dispenser View                          */
/* ============================================ */

.dispenser-root {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(7, 10, 18, 0.82);
}

.dispenser-container {
    flex-grow: 1;
    flex-direction: row;
    padding: 24px;
}

.dispenser-left {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 16px;
    min-width: 400px;
}

.dispenser-right {
    width: 220px;
    flex-direction: column;
    background-color: #111723;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 14px;
    padding: 16px;
}

.dispenser-grid-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 100px;
    max-height: 200px;
    margin-bottom: 8px;
    margin-top: 4px;
}
.dispenser-grid-scroll .unity-scroll-view__content-container {
    padding: 4px;
}
.dispenser-grid-scroll .unity-scroll-view__vertical-scroller {
    width: 7px;
    background-color: transparent;
}
.dispenser-grid-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(130, 160, 205, 0.3);
    border-radius: 4px;
}
.dispenser-grid-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}
.dispenser-grid-scroll .unity-base-slider--horizontal,
.dispenser-grid-scroll .unity-base-slider__low-button,
.dispenser-grid-scroll .unity-base-slider__high-button {
    display: none;
}

.dispenser-info-bar {
    flex-direction: row;
    align-items: center;
    background-color: #111723;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 12px;
    padding: 12px 16px;
    min-height: 70px;
    flex-shrink: 0;
    margin-top: 8px;
}

.dispenser-item-info {
    flex-grow: 1;
    flex-direction: column;
}

.dispenser-info-name {
    font-size: 15px;
    color: #F7FAFF;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.dispenser-info-desc {
    font-size: 12px;
    color: #94A7C4;
    margin-bottom: 2px;
}

.dispenser-info-id {
    font-size: 11px;
    color: #72839D;
}

.dispenser-dispense-btn {
    font-size: 14px;
    color: #F7FAFF;
    background-color: #2F75E8;
    border-width: 1px;
    border-color: #5E98F3;
    border-radius: 9px;
    padding: 10px 24px;
    margin-left: 16px;
    flex-shrink: 0;
}

.dispenser-dispense-btn:hover {
    background-color: #3D82F0;
}

.dispenser-dispense-btn:active {
    background-color: #205FC8;
}

.dispenser-dispense-btn:disabled {
    background-color: #2A3550;
    border-color: rgba(130, 160, 205, 0.2);
    color: #72839D;
}

.dispenser-list-scroll {
    flex-grow: 1;
    margin-top: 8px;
}
.dispenser-list-scroll .unity-scroll-view__content-container {
    padding: 2px;
}
.dispenser-list-scroll .unity-scroll-view__vertical-scroller {
    width: 7px;
    background-color: transparent;
}
.dispenser-list-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(130, 160, 205, 0.3);
    border-radius: 4px;
}
.dispenser-list-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}
.dispenser-list-scroll .unity-base-slider--horizontal,
.dispenser-list-scroll .unity-base-slider__low-button,
.dispenser-list-scroll .unity-base-slider__high-button {
    display: none;
}

.dispenser-container-item {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 3px;
    background-color: #1A2338;
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.20);
    border-radius: 8px;
}

.dispenser-container-item:hover {
    background-color: #222D44;
    border-color: rgba(130, 160, 205, 0.40);
}

.dispenser-container-item--selected {
    background-color: rgba(47, 117, 232, 0.22);
    border-color: #2F75E8;
}

.dispenser-container-item-name {
    font-size: 13px;
    color: #D2DDF0;
    flex-grow: 1;
}
