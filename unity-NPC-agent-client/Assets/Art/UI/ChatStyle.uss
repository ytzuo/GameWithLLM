/* 根节点：75%不透明度的黑色背景（rgba 0,0,0,0.75） */
.chat-root {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.75);
}

/* 聊天滚动区域 */
.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 16px;
}

/* 消息行基础通用样式 */
.message-row {
    flex-direction: row;
    margin-bottom: 20px;
    width: 100%;
}

/* 对方消息容器布局（头像在左） */
.message-opponent {
    justify-content: flex-start;
}

/* 玩家消息容器布局（利用 row-reverse 实现头像在右） */
.message-player {
    flex-direction: row-reverse;
}

/* 头像基础样式（增加白色边框以提升高对比度可见性） */
.avatar {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: #FFFFFF;
}

.avatar-opponent {
    background-color: #555555;
}

.avatar-player {
    background-color: #003399; /* 与玩家气泡相呼应的深蓝色 */
}

/* 气泡基础样式 */
.bubble {
    padding: 10px 14px;
    border-radius: 8px;
    max-width: 70%;
    flex-shrink: 1;
    /* 高对比度风格边框 */
    border-width: 1px;
}

/* 对方气泡：深灰色背景 + 白色边框 */
.bubble-opponent {
    background-color: #1A1A1A;
    border-color: #AAAAAA;
    margin-left: 12px;
}

/* 玩家气泡：深蓝色背景 + 亮蓝色/白色边框 */
.bubble-player {
    background-color: #002266; /* 深蓝色 */
    border-color: #4488FF;
    margin-right: 12px;
}

/* 消息文本通用样式：纯白色以保证高对比度阅读 */
.text-message {
    white-space: normal;
    font-size: 20px;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
}

/* 对方文本靠左 */
.text-opponent {
    -unity-text-align: upper-left;
}

/* 玩家文本现在也要求靠左对齐 */
.text-player {
    -unity-text-align: upper-left;
}

/* 系统消息提示块：高对比度的半透明白底 */
.message-system {
    align-self: center;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 4px 10px;
    margin-bottom: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

/* 系统消息文本 */
.text-system {
    font-size: 16px;
    color: #E0E0E0;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* 底部输入区域容器 */
.input-container {
    flex-direction: row;
    padding: 12px;
    background-color: rgba(26, 26, 26, 0.3);
    border-top-width: 2px;
    border-top-color: #1A1A1A;
    flex-shrink: 0;
    align-items: center;
}

.input-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* 输入框本体 */
.chat-input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

/* 高对比度风格的输入框内部样式 */
.chat-input > .unity-text-field__input {
    padding: 15px 15px;
    border-radius: 5px;
    background-color: #1A1A1A;
    color: #FFFFFF;
    border-width: 1px;
    border-color: #FFFFFF;
    font-size: 20px;
    -unity-text-align: middle-left;
}

/* 占位符提示文本样式：高对比度下的灰色 */
.chat-placeholder {
    position: absolute;
    left: 14px;
    color: #AAAAAA;
    font-size: 20px;
    -unity-text-align: middle-left;
}

/* 1. 垂直滚动条整体容器 */
.chat-scroll .unity-scroll-view__vertical-scroller {
    width: 5px; /* 粗细减半（Unity默认一般为14px左右） */
    background-color: transparent; /* 移除滚动条区域的背景 */
    border-width: 0;
    margin-left: 4px;
}

/* 2. 彻底隐藏首尾的箭头按钮 */
.chat-scroll .unity-scroller__low-button,
.chat-scroll .unity-scroller__high-button {
    display: none;
}

/* 3. 彻底隐藏整个滚动条的槽/轨道 (Tracker) */
.chat-scroll .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

/* 4. 自定义滑块 (Dragger) 样式 */
.chat-scroll .unity-base-slider__dragger {
    background-color: rgba(150, 150, 150, 0.5); /* 半透明灰色 */
    border-width: 0;
    border-radius: 3px; /* 胶囊体形状，更符合现代审美 */
    /* 撑满外层变细后的容器 */
    left: 0;
    right: 0;
    width: 100%;
}