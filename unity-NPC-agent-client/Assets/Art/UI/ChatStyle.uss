.chat-root {
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: rgba(7, 10, 18, 0.82);
}

/* ── 左侧 NPC 列表 ──────────────────────────────────────── */

.npc-list-panel {
    width: 200px;
    min-width: 160px;
    flex-shrink: 0;
    flex-direction: column;
    margin: 24px 0 24px 24px;
    background-color: rgba(17, 23, 35, 0.98);
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 14px;
    overflow: hidden;
}

.npc-list-header {
    height: 52px;
    flex-shrink: 0;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(25, 34, 51, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 160, 205, 0.22);
}

.npc-list-title {
    color: #D2DDF0;
    font-size: 17px;
    -unity-font-style: bold;
}

.npc-list-scroll {
    flex-grow: 1;
    background-color: rgba(10, 15, 25, 0.52);
}

.npc-list-scroll .unity-scroll-view__content-container {
    padding: 8px 10px;
}

.npc-list-container {
    flex-direction: column;
}

.npc-list-item {
    height: 44px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 2px;
    border-radius: 8px;
    background-color: transparent;
    border-width: 0;
    color: #B9C7DC;
    font-size: 15px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    cursor: pointer;
}

.npc-list-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #EAF0FC;
}

.npc-list-item--active {
    background-color: rgba(47, 117, 232, 0.22);
    color: #FFFFFF;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(94, 152, 243, 0.45);
}

.npc-list-item--active:hover {
    background-color: rgba(47, 117, 232, 0.32);
}

/* ── 右侧对话面板 ───────────────────────────────────────── */

.chat-panel {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 24px 24px 24px 10px;
    min-width: 480px;
    min-height: 520px;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(17, 23, 35, 0.98);
    border-width: 1px;
    border-color: rgba(130, 160, 205, 0.45);
    border-radius: 14px;
}

.chat-header {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    padding-right: 14px;
    background-color: rgba(25, 34, 51, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 160, 205, 0.22);
}

.chat-heading {
    flex-grow: 1;
    justify-content: center;
}

.chat-title {
    color: #F7FAFF;
    font-size: 22px;
    -unity-font-style: bold;
}

.chat-subtitle {
    margin-top: 3px;
    color: #94A7C4;
    font-size: 13px;
}

.close-button {
    width: 42px;
    height: 42px;
    margin: 0;
    padding: 0;
    color: #B9C7DC;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    font-size: 28px;
    -unity-font-style: normal;
}

.close-button:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.10);
}

.close-button:active {
    background-color: rgba(255, 255, 255, 0.16);
}

.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(10, 15, 25, 0.52);
}

.chat-scroll .unity-scroll-view__content-container {
    padding: 24px 26px 10px 26px;
}

.message-row {
    width: 100%;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 18px;
}

.message-opponent {
    justify-content: flex-start;
}

.message-player {
    flex-direction: row-reverse;
}

.avatar {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 19px;
}

.avatar-opponent {
    color: #E9F0FF;
    background-color: #465875;
    border-color: #7F95B7;
}

.avatar-player {
    color: #FFFFFF;
    background-color: #2563EB;
    border-color: #6EA1FF;
}

.avatar-label {
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bubble {
    max-width: 72%;
    flex-shrink: 1;
    padding: 11px 15px;
    border-width: 1px;
    border-radius: 12px;
}

.bubble-opponent {
    margin-left: 10px;
    color: #F2F6FC;
    background-color: #242E3E;
    border-color: #3D4B61;
    border-bottom-left-radius: 4px;
}

.bubble-player {
    margin-right: 10px;
    color: #FFFFFF;
    background-color: #1E56C9;
    border-color: #3D7AF0;
    border-bottom-right-radius: 4px;
}

.text-message {
    margin: 0;
    padding: 0;
    color: #FFFFFF;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.message-system {
    align-self: center;
    margin-bottom: 18px;
    padding: 5px 11px;
    background-color: rgba(127, 149, 183, 0.14);
    border-width: 1px;
    border-color: rgba(127, 149, 183, 0.24);
    border-radius: 12px;
}

.text-system {
    margin: 0;
    padding: 0;
    color: #AAB9CE;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.input-container {
    min-height: 82px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    padding: 14px 18px 8px 18px;
    background-color: #192233;
    border-top-width: 1px;
    border-top-color: rgba(130, 160, 205, 0.20);
}

.input-wrapper {
    position: relative;
    flex-grow: 1;
    justify-content: center;
}

.chat-input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.chat-input > .unity-text-field__input {
    min-height: 52px;
    max-height: 116px;
    padding: 13px 15px;
    color: #F8FAFF;
    background-color: #0E1522;
    border-width: 1px;
    border-color: #47566D;
    border-radius: 9px;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: upper-left;
    --unity-cursor-color: #74C7FF;
    --unity-cursor-width: 2px;
    --unity-selection-color: rgba(54, 143, 255, 0.55);
}

.chat-input:focus > .unity-text-field__input,
.chat-input > .unity-text-field__input:focus {
    border-color: #4DA3FF;
    background-color: #101A2A;
}

.chat-placeholder {
    position: absolute;
    left: 16px;
    top: 16px;
    color: #6F809A;
    font-size: 17px;
}

.send-button {
    width: 84px;
    height: 52px;
    flex-shrink: 0;
    margin: 0 0 0 10px;
    padding: 0;
    color: #FFFFFF;
    background-color: #2F75E8;
    border-width: 1px;
    border-color: #5E98F3;
    border-radius: 9px;
    font-size: 16px;
    -unity-font-style: bold;
}

.send-button:hover {
    background-color: #3D82F0;
}

.send-button:active {
    background-color: #205FC8;
}

.send-button:disabled {
    color: #718098;
    background-color: #263247;
    border-color: #344158;
}

.input-meta {
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    padding-left: 20px;
    padding-right: 20px;
    background-color: #192233;
}

.input-hint {
    flex-grow: 1;
    color: #72839D;
    font-size: 12px;
}

.character-count {
    color: #72839D;
    font-size: 12px;
    -unity-text-align: upper-right;
}

.character-count-warning {
    color: #F6B860;
}

.chat-scroll .unity-scroll-view__vertical-scroller {
    width: 7px;
    margin: 6px 4px 6px 2px;
    background-color: transparent;
    border-width: 0;
}

.chat-scroll .unity-scroller__low-button,
.chat-scroll .unity-scroller__high-button {
    display: none;
}
